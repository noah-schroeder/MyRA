{
  "name": "karen",
  "version": "0.1.0",
  "private": true,
  "description": "Karen \u2014 a private, local-first executive assistant",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "vm/bridge"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:extensions",
    "test:extensions": "node --test --experimental-strip-types --no-warnings vm/extensions/test/*.test.ts",
    "pretest:extensions": "./scripts/link-extension-deps.sh",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p vm/extensions/tsconfig.json",
    "pretypecheck": "./scripts/link-extension-deps.sh"
  }
}
