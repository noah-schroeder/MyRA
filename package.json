{
  "name": "myra",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "MyRA — a private, local-first assistant for academic work",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:x11": "electron-vite dev -- --ozone-platform=x11",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings --import ./test/setup.ts test/*.test.ts",
    "dist": "electron-vite build && electron-builder",
    "deb": "electron-vite build && electron-builder --linux deb"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "marked": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  },
  "author": {
    "name": "Noah Schroeder",
    "email": "noah-schroeder@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noah-schroeder/myra.git"
  },
  "homepage": "https://github.com/noah-schroeder/myra",
  "desktopName": "dev.myra.app.desktop"
}
