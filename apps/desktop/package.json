{
  "name": "@karen/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Karen desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "electron-vite preview",
    "deb": "electron-vite build && electron-builder --linux deb",
    "test": "node --test test/*.test.ts",
    "dev:vm": "electron-vite dev -- --ozone-platform=x11 --no-sandbox",
    "start:vm": "electron . --ozone-platform=x11 --no-sandbox"
  },
  "dependencies": {
    "@karen/protocol": "*",
    "marked": "^18.0.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  },
  "author": {
    "name": "Noah Schroeder",
    "email": "noah-schroeder@users.noreply.github.com"
  },
  "homepage": "https://karen.invalid/",
  "desktopName": "dev.karen.app.desktop"
}
